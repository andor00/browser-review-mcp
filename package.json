{
  "name": "browser-review-mcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "packageManager": "pnpm@12.9.1",
  "scripts": {
    "server": "pnpm --dir server start",
    "dev:server": "pnpm --dir server dev",
    "build": "pnpm --dir extension build",
    "dev:extension": "pnpm --dir extension dev",
    "typecheck": "pnpm -r typecheck",
    "test": "node --test \"scripts/**/*.test.ts\" && pnpm -r test",
    "version:bump": "node scripts/version.ts bump",
    "version:sync": "node scripts/version.ts sync",
    "prepare": "git rev-parse --git-dir >/dev/null 2>&1 && git config core.hooksPath .githooks || true"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "typescript": "^7.0.2"
  }
}
